# Django Control Plane Configuration
DJANGO_SECRET_KEY=forge-insecure-dev-key-change-in-production-1234567890
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL 16 (Relational Auth & Control Plane)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forge_db
POSTGRES_USER=forge_user
POSTGRES_PASSWORD=forge_password

# MongoDB 7.0 (Multi-Document Tenant Data Plane)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=forge_tenant_data

# Cryptographic Secrets
FORGE_SERVER_SECRET=c8f0e5b7a1d34f9a8e2b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f
JWT_SECRET_KEY=jwt-signing-secret-key-32-chars-long-minimum-secure-forge-key
JWT_LIFETIME_SECONDS=3600

# AWS SQS & S3 (LocalStack / AWS Cloud)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_OUTBOX_QUEUE_URL=http://localhost:4566/000000000000/forge-events
SQS_DLQ_QUEUE_URL=http://localhost:4566/000000000000/forge-events-dlq
S3_EXPORT_BUCKET_NAME=forge-exports

